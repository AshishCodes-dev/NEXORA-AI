# NEXORA Frontend Environment Configuration
# ==============================================================================
# NOTE: All variables prefixed with VITE_ are public and embedded into the client
# bundle at build time. NEVER put private server secrets, database credentials,
# or private API keys here.
# ==============================================================================

# API Base URL (VITE_API_URL):
# ------------------------------------------------------------------------------
# 1. Local Development (Default):
#    - Set to: http://localhost:5000
#    - If undefined or omitted, the frontend automatically falls back to http://localhost:5000.
#
# 2. Deployed Production Frontend:
#    - Set VITE_API_URL to your actual public backend origin.
#    - Example placeholder: https://your-real-backend-domain.example
#      (NOTE: This is a placeholder and MUST be replaced with your real backend origin URL).
#    - The browser sends API requests directly to this backend origin with credentials: "include".
#    - On the backend, configure CORS_ORIGIN to include the exact deployed frontend origin.
#      Example placeholder: https://your-real-frontend-domain.example
#      (NOTE: This is also a placeholder and must match your deployed frontend origin).
#
# NOTE: Vercel does not use a same-origin proxy rewrite for /api requests; the frontend communicates
# via direct cross-origin requests to the backend origin defined by VITE_API_URL.
VITE_API_URL=http://localhost:5000

# Vercel Deployment Instructions:
# ------------------------------------------------------------------------------
# When deploying this repository on Vercel:
# In Vercel Project Settings > General, you MUST set the "Root Directory" to:
#   frontend/nexora
# This ensures Vercel properly detects package.json, vite.config.js, and vercel.json.

# Google OAuth 2.0 Web Client ID for Google Identity Services (GIS):
# ------------------------------------------------------------------------------
# When set, enables the Google Sign-In button on Login and Signup pages.
# When unset/empty, the Google Sign-In button renders safely disabled as (COMING SOON).
# Must match the GOOGLE_CLIENT_ID configured on the backend.
VITE_GOOGLE_CLIENT_ID=
