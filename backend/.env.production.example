# ==============================================================================
# NEXORA AI — Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env in your production backend environment:
#   cp .env.production.example .env
#
# IMPORTANT:
# - Never commit real .env files with secrets to source control.
# - Keep permissions restricted on production host: chmod 600 .env
# ==============================================================================

# ------------------------------------------------------------------------------
# CORE SERVER SETTINGS (REQUIRED)
# ------------------------------------------------------------------------------
# Production environment flag enforces strict security validations at startup:
# - Requires JWT_SECRET to be explicitly set and >= 32 characters
# - Enforces HttpOnly cookies with SameSite=strict and Secure=true
# - Requires CORS_ORIGIN / FRONTEND_URL to be explicitly configured (no localhost fallback)
# - Enables HSTS headers
NODE_ENV=production
PORT=5000

# ------------------------------------------------------------------------------
# DATABASE CONNECTION (REQUIRED)
# ------------------------------------------------------------------------------
# Production MongoDB connection string with authentication.
# In Docker deployments, use the container service name (e.g. mongodb).
MONGODB_URI=mongodb://nexora_admin:REPLACE_WITH_STRONG_DB_PASSWORD@mongodb:27017/nexora?authSource=admin

# ------------------------------------------------------------------------------
# AUTHENTICATION & JWT SECURITY (REQUIRED)
# ------------------------------------------------------------------------------
# High-entropy secret key for signing user session JWTs.
# Must be at least 32 characters long in production.
# Generate a strong cryptographically secure random secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# or:
#   openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_MINIMUM_32_CHAR_CRYPTOGRAPHICALLY_RANDOM_SECRET

# ------------------------------------------------------------------------------
# CORS & FRONTEND BINDING (REQUIRED IN PRODUCTION)
# ------------------------------------------------------------------------------
# Approved origin(s) allowed to make credentialed requests to the backend API.
# Multiple origins may be specified as a comma-separated list.
# NOTE: Wildcards ('*') are strictly rejected for credentialed cookies.
# Localhost origins are rejected when NODE_ENV=production.
# Examples:
#   FRONTEND_URL=https://app.nexora.ai
#   CORS_ORIGIN=https://app.nexora.ai,https://admin.nexora.ai
FRONTEND_URL=https://app.nexora.ai
CORS_ORIGIN=https://app.nexora.ai

# ------------------------------------------------------------------------------
# REVERSE PROXY TRUST (REQUIRED IF BEHIND NGINX, CLOUDFLARE, AWS ALB, TRAEFIK)
# ------------------------------------------------------------------------------
# Controls whether Express trusts the X-Forwarded-* headers for IP derivation.
# - Set to 1 if behind a single reverse proxy hop (NGINX, Docker bridge, Traefik).
# - Set to true or comma-separated proxy subnet / IPs if applicable.
# - Leave unset or false if the backend receives direct client connections.
TRUST_PROXY=1

# ------------------------------------------------------------------------------
# RATE LIMITING POLICIES (OPTIONAL, DEFAULTS APPLIED IF OMITTED)
# ------------------------------------------------------------------------------
# Mission creation burst protection (POST /api/missions).
# Governs maximum allowed mission creations per user (or IP fallback) per window.
# Note: In-memory store is local per Node process.
MISSION_RATE_LIMIT_WINDOW_MS=900000
MISSION_RATE_LIMIT_MAX=15

# ------------------------------------------------------------------------------
# AI PROVIDERS & EXTERNAL APIS (OPTIONAL)
# ------------------------------------------------------------------------------
# Google Gemini API Key for dynamic multi-agent planning and analysis.
# If omitted, invalid, or unavailable, NEXORA automatically uses deterministic fallback.
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# GOOGLE OAUTH IDENTITY SERVICES (OPTIONAL)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Client ID for verifying Google Identity Services ID tokens
# via POST /api/auth/google.
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs.
# Ensure Authorized JavaScript Origins include your frontend URL(s) (e.g. https://app.nexora.ai).
# If left blank, Google authentication is disabled on the backend (returns 503).
GOOGLE_CLIENT_ID=
